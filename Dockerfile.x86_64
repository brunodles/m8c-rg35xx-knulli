FROM ubuntu:25.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LINUX_KERNEL_VERSION=4.9.170
ENV M8C_VERSION=2.2.3
# SDL3 version and checksum (kept in sync with upstream laamaa/m8c CI)
ENV SDL_VERSION=3.2.20
ENV SDL_SHA256=467600ae090dd28616fa37369faf4e3143198ff1da37729b552137e47f751a67
ENV XTOOL=/build/aarch64-buildroot-linux-gnu_sdk-buildroot
ENV XHOST=aarch64-buildroot-linux-gnu

# Update and install required packages.
# Note: libsdl3-dev is intentionally NOT installed here because apt installs the
# host-architecture (x86_64) package, which cannot be used when cross-compiling
# for ARM64.  SDL3 is instead built from source and installed into the Knulli
# toolchain sysroot (see the cross-compile step below).
# cmake and ninja-build are required to build SDL3 from source.
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update && \
    apt-get install -y \
    wget \
    tar \
    make \
    gcc \
    sed \
    crossbuild-essential-arm64 \
    ca-certificates \
    bc \
    libssl-dev \
    pkg-config \
    dos2unix \
    git \
    cmake \
    ninja-build \
    libserialport-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Download and extract Linux kernel
RUN wget https://cdn.kernel.org/pub/linux/kernel/v4.x/linux-${LINUX_KERNEL_VERSION}.tar.gz && \
    tar -xzf linux-${LINUX_KERNEL_VERSION}.tar.gz && \
    rm linux-${LINUX_KERNEL_VERSION}.tar.gz

# Download and prepare m8c
RUN wget https://github.com/laamaa/m8c/archive/refs/tags/v${M8C_VERSION}.tar.gz \
    && tar -xzvf v${M8C_VERSION}.tar.gz \
    && mv m8c-${M8C_VERSION} m8c \
    && rm v${M8C_VERSION}.tar.gz

# Download Knulli Linux config file
RUN wget -O linux-sunxi64-legacy.config https://raw.githubusercontent.com/knulli-cfw/distribution/knulli-main/board/batocera/allwinner/h700/linux-sunxi64-legacy.config

# Download and extract Knulli ARM64 toolchain with retry
RUN wget -O aarch64-buildroot-linux-gnu_sdk-buildroot.tar.gz https://github.com/knulli-cfw/toolchains/releases/download/rg35xx-plush-sdk-20240421/aarch64-buildroot-linux-gnu_sdk-buildroot.tar.gz \
    && tar -xzvf aarch64-buildroot-linux-gnu_sdk-buildroot.tar.gz \
    && rm aarch64-buildroot-linux-gnu_sdk-buildroot.tar.gz

# Cross-compile SDL3 for the target device and install it into the Knulli
# toolchain sysroot.  The Knulli SDK pre-dates SDL3, so SDL3 is not included
# in the sysroot. We build SDL3 shared libraries here so the runtime package
# can ship libSDL3.so for dynamic loading on the target device.
#
# CMAKE_INSTALL_PREFIX=/usr  – the runtime path on the target device
# CMAKE_STAGING_PREFIX        – where files land on the build host (the sysroot)
# PKG_CONFIG_SYSROOT_DIR in build_script.x86_64.sh then transforms /usr/* →
# $SYSROOT/usr/* so the cross-compiler resolves headers and libraries correctly.
RUN export PATH=$PATH:$XTOOL/bin && \
    export SYSROOT=$XTOOL/$XHOST/sysroot && \
    wget -O SDL3-${SDL_VERSION}.tar.gz \
        https://github.com/libsdl-org/SDL/releases/download/release-${SDL_VERSION}/SDL3-${SDL_VERSION}.tar.gz && \
    echo "${SDL_SHA256}  SDL3-${SDL_VERSION}.tar.gz" | sha256sum -c - || \
        { echo "SDL3 archive checksum failed"; exit 1; } && \
    tar zxf SDL3-${SDL_VERSION}.tar.gz && \
    cmake -S SDL3-${SDL_VERSION} \
        -B SDL3-${SDL_VERSION}/build \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
        -DCMAKE_C_COMPILER=${XHOST}-gcc \
        -DCMAKE_SYSROOT=${SYSROOT} \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_STAGING_PREFIX=${SYSROOT}/usr \
        -DSDL_UNIX_CONSOLE_BUILD=ON \
        -DSDL_X11=OFF \
        -DSDL_WAYLAND=OFF \
        -DSDL_STATIC=OFF \
        -DSDL_SHARED=ON \
        -DSDL_TEST=OFF \
        -DSDL_TESTS=OFF \
        -DSDL_EXAMPLES=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -G Ninja && \
    ninja -C SDL3-${SDL_VERSION}/build install && \
    rm -rf SDL3-${SDL_VERSION} SDL3-${SDL_VERSION}.tar.gz

COPY build_script.x86_64.sh /build/build_script.sh
RUN chmod +x /build/build_script.sh && dos2unix /build/build_script.sh

# Ensure the output directory exists
RUN mkdir -p /build/compiled/m8c

CMD ["/bin/bash", "/build/build_script.sh"]
